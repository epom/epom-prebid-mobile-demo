# Copy to keystore.properties (which git ignores) and fill in. Create the key once with:
#   keytool -genkey -v -keystore epom-demo-upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias upload
# Keep the .jks and these passwords somewhere you will still have them in two years: Play ties the
# app to this key, and losing it means asking Google to reset it.
storeFile=../epom-demo-upload.jks
storePassword=
keyAlias=upload
keyPassword=
